{
  "name": "vitae-health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "lint": "eslint .",
    "test": "vitest run tests/domain.test.ts tests/demo.test.ts tests/catalogue.test.ts tests/quiz.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-vitae \"vitest run tests/rules.test.ts\"",
    "test:firebase": "npm run functions:build && firebase emulators:exec --only auth,firestore,functions,storage --project demo-vitae \"tsx scripts/verify-firebase.ts\"",
    "test:e2e": "playwright test",
    "functions:build": "npm --prefix functions run build",
    "staff": "tsx scripts/staff.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
