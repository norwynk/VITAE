rules_version = '2';

// Health, clinical, order and audit data flow only through audited Cloud
// Functions (Admin SDK). Clients get three narrow read exceptions and no writes.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasRole(roles) {
      return signedIn() && request.auth.token.role in roles;
    }

    // Public catalogue entries only; never mutable from a client.
    match /treatments/{treatmentId} {
      allow read: if resource.data.public == true;
      allow write: if false;
    }

    match /biomarkerDefinitions/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /operationalProfiles/{memberId} {
      allow read: if hasRole(['OPERATIONS', 'SUPER_ADMIN']);
      allow write: if false;
    }

    // Everything else is denied to clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
