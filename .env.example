# Data mode: both must match ("demo" or "live"). The build refuses a mismatch.
DATA_MODE=demo
NEXT_PUBLIC_DATA_MODE=demo

# Demo mode (fictional data in .demo/). Refused in production unless set to true.
# ALLOW_PRODUCTION_DEMO=false
# DEMO_SESSION_SECRET=   # optional; generated into .demo/ if unset

# Live mode (Firebase). Not configured yet: no Firebase project exists.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Point the browser at local emulators (never set in production).
NEXT_PUBLIC_FIREBASE_EMULATORS=false
